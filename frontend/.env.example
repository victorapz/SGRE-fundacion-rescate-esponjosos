NODE_ENV=production
VITE_API_URL=https://api.example.com/api
VITE_PAYPAL_ENV=sandbox
VITE_PUBLIC_SITE_URL=https://example.com

# VITE_* values are embedded in the browser bundle. Configure only data that is
# deliberately public; never place passwords, private tokens, or API secrets here.
VITE_TRANSFER_HOLDER=Fundacion Ejemplo
VITE_TRANSFER_RUT=XX.XXX.XXX-X
VITE_TRANSFER_BANK=Banco Ejemplo
VITE_TRANSFER_ACCOUNT_TYPE=Cuenta Vista
VITE_TRANSFER_ACCOUNT_NUMBER=XXXXXXXX
VITE_TRANSFER_EMAIL=donaciones@example.com

FRONTEND_PORT=3443
TLS_CERT_PATH=/path/outside/repository/frontend.crt
TLS_KEY_PATH=/path/outside/repository/frontend.key
