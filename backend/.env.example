NODE_ENV=production
PORT=3000
APP_HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=fundacion_example
DB_USERNAME=postgres
DB_PASSWORD=change_me

ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_REFRESH_COOKIE_NAME=refreshToken
AUTH_REFRESH_COOKIE_PATH=/api/auth
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_DOMAIN=

TRUST_PROXY=loopback
CORS_ALLOWED_ORIGINS=https://example.com
CORS_ALLOW_CREDENTIALS=true
PUBLIC_FRONTEND_URL=https://example.com
BACKEND_PUBLIC_URL=https://api.example.com
SHIFT_CAPACITY=5
SCHEDULER_TZ=America/Santiago

# Demo data is disabled by default. Built-in credentials are only available for
# fictional demo users outside production. Production requires DEMO_SEED_PASSWORD
# if SEED_DEMO_DATA is explicitly enabled.
SEED_DEMO_DATA=false
DEMO_SEED_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_VOLUNTEER_PASSWORD=
SEED_AREA_MANAGER_PASSWORD=
SEED_INVENTORY_LOCAL_PASSWORD=

MINIO_ENDPOINT=minio.example.com
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_BUCKET_PRIVATE=fundacion-example-private
MINIO_BUCKET_PUBLIC=fundacion-example-public
MINIO_PRESIGNED_EXPIRATION=900

FILE_MAX_SIZE_MB=10
FILE_ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp
FILE_ALLOWED_DOCUMENT_MIME=application/pdf,image/jpeg,image/png,image/webp
FILE_PUBLIC_DELIVERY_MODE=proxy

PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=
PAYPAL_REQUEST_TIMEOUT_MS=10000
PAYPAL_DONATION_SUCCESS_URL=https://example.com/donacion/success
PAYPAL_DONATION_CANCEL_URL=https://example.com/donacion/cancel
PAYPAL_SUBSCRIPTION_RETURN_URL=https://example.com/apadrinamiento/success
PAYPAL_SUBSCRIPTION_CANCEL_URL=https://example.com/apadrinamiento/cancel
PAYPAL_SUBSCRIPTION_BRAND_NAME=Fundacion Rescate Esponjosos
