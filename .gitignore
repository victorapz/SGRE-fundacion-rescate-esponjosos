# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment files (examples are intentionally versioned)
.env
.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Build output
dist/
build/
frontend/dist/
backend/dist/

# Logs and runtime files
*.log
logs/
*.pid
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Temporary and cache files
tmp/
temp/
*.tmp
.cache/

# Certificates and private keys
*.pem
*.key
*.crt
*.p12
*.pfx
certificates/

# External tunnel configuration
ngrok.yml
.ngrok2/
.config/ngrok/

# Database dumps and backups (SQL migrations remain versioned)
*.dump
*.backup
*.bak
*.sql.gz

# OS and IDE metadata
.DS_Store
Thumbs.db
.idea/
